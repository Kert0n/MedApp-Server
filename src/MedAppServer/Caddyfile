medapp.el-communication.ru {
	request_body {
		max_size 64KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Caddy safely creates X-Forwarded-* headers. Spring trusts them only from
	# the isolated edge Docker network configured in compose.yaml.
	reverse_proxy med-app-server:8080
}
