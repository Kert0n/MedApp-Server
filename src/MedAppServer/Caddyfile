medapp.el-communication.ru {

    # Caddy сам ставит X-Forwarded-For / -Proto / -Host и дописывает к существующей
    # цепочке. Ручной header_up затирал цепочку, а бэкенд всё равно эти заголовки
    # игнорировал, пока не был включён forward-headers-strategy=native.
    reverse_proxy med-app-server:8080

    # Логи в stdout (подхватываются docker logs)
    log {
        output stdout
        format console
    }
}

