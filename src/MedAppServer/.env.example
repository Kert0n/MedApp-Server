# Скопировать в .env рядом с compose.yaml. Файл в git не попадает.
#
# Нужен ровно для того, чтобы пароль базы не лежал в репозитории: раньше он был
# захардкожен в compose.yaml как POSTGRES_PASSWORD=secret и при этом порт 5432 был
# опубликован на хост.
#
# Обе переменные обязательны — compose падает сразу, а не поднимает базу со слабым
# паролем.

POSTGRES_USER=medapp
POSTGRES_PASSWORD=замените-на-длинный-случайный
